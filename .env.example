# ╔══════════════════════════════════════════════════════════════════════════╗
# ║   EthioSchool SaaS — Environment Variables                              ║
# ║   Copy this file to .env and fill in real values before deploying.      ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ─── Django Core ─────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secure-secret-key-here-minimum-50-chars

# In production: your actual domain(s), comma-separated
# Example: ALLOWED_HOSTS=ethioschool.et,www.ethioschool.et
ALLOWED_HOSTS=127.0.0.1,localhost

# ─── Database (PostgreSQL for production) ────────────────────────────────────
# Option A: single URL (recommended)
DATABASE_URL=postgresql://user:password@localhost:5432/ethioschool_prod

# Option B: individual variables (used if DATABASE_URL is not set)
DB_NAME=ethioschool_prod
DB_USER=ethioschool
DB_PASSWORD=your-strong-db-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=require

# ─── Redis (cache + Celery broker) ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=EthioSchool SaaS <noreply@ethioschool.et>

# ─── Chapa Payment Gateway ───────────────────────────────────────────────────
# Replace with LIVE keys before go-live (remove CHASECK_TEST prefix)
CHAPA_SECRET_KEY=CHASECK_TEST-your-key-here
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-your-key-here
CHAPA_WEBHOOK_SECRET=your-webhook-signing-secret
